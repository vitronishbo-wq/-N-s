# ============================================================
# ÉNÓS / CPLP RELACIONAMENTOS
# Environment Configuration Template (.env.example)
# ============================================================

# ------------------------------------------------------------
# AMBIENTE E APLICAÇÃO
# ------------------------------------------------------------
NODE_ENV=production
APP_NAME=ÉNós
PLATFORM_ID=cplp-relacionamentos
ENVIRONMENT=production
APP_VERSION=1.0.0
APP_URL=
API_URL=
FRONTEND_URL=

# ------------------------------------------------------------
# LOCALIZAÇÃO E INTERNACIONALIZAÇÃO
# ------------------------------------------------------------
DEFAULT_LOCALE=pt-AO
DEFAULT_TIMEZONE=Africa/Luanda
DEFAULT_CURRENCY=AOA
DEFAULT_COUNTRY_CODE=AO

# ------------------------------------------------------------
# FIREBASE ADMIN SDK / FIRESTORE
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------
# GOOGLE AI / GEMINI
# ------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# GMAIL OAUTH 2.0 / GOOGLE WORKSPACE
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_SCOPES=https://mail.google.com/
SUPPORT_EMAIL=

# ------------------------------------------------------------
# CORS & SEGURANÇA
# ------------------------------------------------------------
CORS_ENABLED=true
CORS_ORIGINS=

# ------------------------------------------------------------
# API / OBSERVABILIDADE
# ------------------------------------------------------------
LOG_LEVEL=info
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH=/api/health
METRICS_ENABLED=false
TRACING_ENABLED=false

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
MATCHING_V1=true
AI_PROFILE_ASSISTANT=true
VIDEO=false
AUDIO=false
RELATIONSHIP_SPACE=false
VERIFICATION=false
COMMUNITIES=false
EVENTS=false

# ------------------------------------------------------------
# LIMITES OPERACIONAIS & DESCOBERTA
# ------------------------------------------------------------
DISCOVERY_DEFAULT_PAGE_SIZE=20
DISCOVERY_MAX_PAGE_SIZE=50
DISCOVERY_LOW_AVAILABILITY_THRESHOLD=5
DISCOVERY_COOLDOWN_HOURS=24

# ------------------------------------------------------------
# IA E ASSISTENTES
# ------------------------------------------------------------
AI_ENABLED=true
AI_COMPATIBILITY_EXPLANATION_ENABLED=true
AI_CONVERSATION_ASSISTANT_ENABLED=false
AI_CONTENT_ASSISTANT_ENABLED=false

# ------------------------------------------------------------
# PRODUÇÃO & HARDENING
# ------------------------------------------------------------
PRODUCTION_REQUIRE_TLS=true
PRODUCTION_REQUIRE_SECRETS=true
PRODUCTION_DISABLE_DEBUG=true
PRODUCTION_DISABLE_DEV_ROUTES=true
