# ============================================================
# ÉNÓS / CPLP RELACIONAMENTOS
# Environment Configuration Template (.env.example)
# ============================================================
#
# ARQUITETURA:
# Google AI Studio
#        ↓
# GitHub
#        ↓
# GitHub Actions
#        ↓
# Firebase Hosting + Render API
#        ↓
# Firebase / Firestore
#
# IMPORTANTE:
# - Nunca colocar valores reais neste ficheiro.
# - Usar placeholders ou deixar valores vazios.
# - Segredos reais devem ser configurados no ambiente adequado.
# ============================================================


# ------------------------------------------------------------
# AMBIENTE E APLICAÇÃO
# ------------------------------------------------------------
NODE_ENV=development

APP_NAME=ÉNós
PLATFORM_ID=cplp-relacionamentos
APP_VERSION=1.0.0

# development | staging | production
ENVIRONMENT=development

# URLs públicas
APP_URL=
FRONTEND_URL=
API_URL=

# Backend Render
PORT=3000


# ------------------------------------------------------------
# LOCALIZAÇÃO E INTERNACIONALIZAÇÃO
# ------------------------------------------------------------
DEFAULT_LOCALE=pt-AO
DEFAULT_TIMEZONE=Africa/Luanda
DEFAULT_CURRENCY=AOA
DEFAULT_COUNTRY_CODE=AO


# ------------------------------------------------------------
# FIREBASE WEB SDK
# FRONTEND / VITE
#
# Estas variáveis são usadas pelo React/Vite.
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL pública da API no Render
VITE_RENDER_API_URL=


# ------------------------------------------------------------
# FIREBASE ADMIN SDK
# BACKEND / RENDER
#
# Usado exclusivamente pelo backend Node.js.
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternativa opcional:
# JSON completo da Service Account.
# Utilizar apenas uma estratégia no backend:
# FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
# OU FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT=


# ------------------------------------------------------------
# GOOGLE AI / GEMINI
#
# O backend deve usar UMA chave canónica.
# ------------------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Compatibilidade temporária com código existente.
# FUTURE: remover quando todo o código usar a variável canónica.
GEMINI_API_KEY=


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ENABLED=true

# Development:
# Exemplo:
# http://localhost:5173
#
# Production:
# https://www.seudominio.ao
CORS_ORIGINS=


# ------------------------------------------------------------
# API / OBSERVABILIDADE
# ------------------------------------------------------------
LOG_LEVEL=info

HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH=/health

VERSION_PATH=/version

METRICS_ENABLED=false
TRACING_ENABLED=false


# ------------------------------------------------------------
# IDENTIFICAÇÃO DE REQUESTS E ERROS
# ------------------------------------------------------------
REQUEST_ID_ENABLED=true
ERROR_ID_ENABLED=true


# ------------------------------------------------------------
# FEATURE FLAGS
#
# Funcionalidades futuras podem existir como capacidade,
# sem estarem necessariamente expostas ao utilizador.
# ------------------------------------------------------------
MATCHING_V1=true
AI_PROFILE_ASSISTANT=true

VIDEO=false
AUDIO=false
RELATIONSHIP_SPACE=false
VERIFICATION=false
COMMUNITIES=false
EVENTS=false


# ------------------------------------------------------------
# DESCOBERTA
# ------------------------------------------------------------
DISCOVERY_DEFAULT_PAGE_SIZE=20
DISCOVERY_MAX_PAGE_SIZE=50

DISCOVERY_LOW_AVAILABILITY_THRESHOLD=5
DISCOVERY_COOLDOWN_HOURS=24

# CITY
# REGION
# COUNTRY
# CPLP_SELECTED
# CPLP_GLOBAL
DISCOVERY_EXPANSION_ENABLED=true


# ------------------------------------------------------------
# MATCHING
# ------------------------------------------------------------
MATCHING_DETERMINISTIC_ENABLED=true
MATCHING_AI_ENRICHMENT_ENABLED=true

MATCHING_EXPLAINABILITY_ENABLED=true
MATCHING_DIVERSITY_GUARD_ENABLED=true
MATCHING_COUNTRY_AFFINITY_ENABLED=true


# ------------------------------------------------------------
# IA E ASSISTENTES
#
# IA nunca é autoridade exclusiva sobre:
# elegibilidade, bloqueios, segurança ou decisões irreversíveis.
# ------------------------------------------------------------
AI_ENABLED=true

AI_COMPATIBILITY_EXPLANATION_ENABLED=true
AI_PROFILE_ASSISTANT_ENABLED=true

AI_CONVERSATION_ASSISTANT_ENABLED=false
AI_CONTENT_ASSISTANT_ENABLED=false


# ------------------------------------------------------------
# MEDIA / FIREBASE STORAGE
# ------------------------------------------------------------
MEDIA_ENABLED=true

MEDIA_CLIENT_COMPRESSION_ENABLED=true
MEDIA_THUMBNAILS_ENABLED=true
MEDIA_LAZY_LOADING_ENABLED=true

MEDIA_DEFAULT_IMAGE_FORMAT=webp

MEDIA_MAX_PROFILE_IMAGE_SIZE_MB=5
MEDIA_MAX_MESSAGE_IMAGE_SIZE_MB=10

MEDIA_VIDEO_ENABLED=false


# ------------------------------------------------------------
# LIGHT-FIRST / PERFORMANCE
# ------------------------------------------------------------
LIGHT_FIRST_ENABLED=true

LAZY_LOADING_ENABLED=true
PROGRESSIVE_LOADING_ENABLED=true
CLIENT_IMAGE_COMPRESSION_ENABLED=true

AVOID_EAGER_MEDIA_LOADING=true
SELECTIVE_FIRESTORE_LISTENERS=true


# ------------------------------------------------------------
# FIRESTORE
# ------------------------------------------------------------
FIRESTORE_SOURCE_OF_TRUTH=true

FIRESTORE_PAGINATION_ENABLED=true

# Evitar carregar documentos ou coleções desnecessariamente.
FIRESTORE_SELECTIVE_READS=true


# ------------------------------------------------------------
# AUTENTICAÇÃO
# ------------------------------------------------------------
FIREBASE_ANONYMOUS_AUTH_ENABLED=true

ACCOUNT_LINKING_ENABLED=true
ACCOUNT_RECOVERY_ENABLED=true


# ------------------------------------------------------------
# PRIVACIDADE
# ------------------------------------------------------------
PRIVACY_SETTINGS_ENABLED=true

DISCOVERY_PRIVACY_FILTER_ENABLED=true
BLOCK_FILTER_ENABLED=true
REPORT_FILTER_ENABLED=true


# ------------------------------------------------------------
# SAFETY
# ------------------------------------------------------------
BLOCKS_ENABLED=true
REPORTS_ENABLED=true

MODERATION_ENABLED=true

# IA pode auxiliar, mas não tomar decisões irreversíveis sozinha.
AI_SAFETY_AUTONOMOUS_ACTIONS_ENABLED=false


# ------------------------------------------------------------
# PRODUÇÃO / HARDENING
# ------------------------------------------------------------
PRODUCTION_REQUIRE_TLS=true
PRODUCTION_REQUIRE_SECRETS=true

PRODUCTION_DISABLE_DEBUG=true
PRODUCTION_DISABLE_DEV_ROUTES=true


# ------------------------------------------------------------
# DEPLOY
# ------------------------------------------------------------
FIREBASE_HOSTING_ENABLED=true

RENDER_API_ENABLED=true
RENDER_AUTO_DEPLOY=true


# ============================================================
# FUTURE
# Não implementar automaticamente.
# ============================================================
# PAYMENTS
# SUBSCRIPTIONS
# APPYPAY
# VIDEO
# AUDIO
# RELATIONSHIP SPACE
# VERIFICATION
# COMMUNITIES
# EVENTS
# ADVANCED ANALYTICS
# ============================================================