{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with CPLP location, intent, and cultural interests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "age": { "type": "number" },
        "bio": { "type": "string" },
        "countryCode": { "type": "string" },
        "cityName": { "type": "string" },
        "intent": { "type": "string" },
        "interests": { "type": "array" },
        "photos": { "type": "array" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "displayName", "countryCode", "cityName", "intent"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message conversation between connected users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantUids": { "type": "array" },
        "lastMessageText": { "type": "string" },
        "lastMessageTimestamp": { "type": "number" },
        "unreadCount": { "type": "number" }
      },
      "required": ["id", "participantUids"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "senderUid", "text", "timestamp"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "active": { "type": "boolean" },
        "countryCode": { "type": "string" }
      },
      "required": ["id", "role"]
    },
    "PublicTrustBadges": {
      "title": "PublicTrustBadges",
      "description": "Backend-validated minimal public trust badges",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "badges": { "type": "array" },
        "issuedByAuthority": { "type": "string" },
        "evaluatedAt": { "type": "number" }
      },
      "required": ["userId", "badges"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "description": "User identity verification request with proof documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "evidenceType": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "number" }
      },
      "required": ["id", "userId", "evidenceType", "status"]
    },
    "McrAuditEvent": {
      "title": "McrAuditEvent",
      "description": "Auditable, immutable transition event in the 8-stage Meaningful Connection Rate funnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetUid": { "type": "string" },
        "stage": { "type": "string" },
        "stageRank": { "type": "number" },
        "previousStage": { "type": "string" },
        "countryPair": { "type": "array" },
        "discoveryOrigin": { "type": "string" },
        "communityTag": { "type": "string" },
        "metadata": { "type": "object" },
        "audit": { "type": "object" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "targetUid", "stage", "countryPair", "audit", "timestamp"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Public and discovered user profile documents"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct chat rooms between matched CPLP community members"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a conversation"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Administrative access profiles and roles"
    },
    "/public_trust_badges/{userId}": {
      "schema": "PublicTrustBadges",
      "description": "Server-authorized public trust badges"
    },
    "/verification_requests/{requestId}": {
      "schema": "VerificationRequest",
      "description": "Identity verification submission queue"
    },
    "/mcr_audit_events/{eventId}": {
      "schema": "McrAuditEvent",
      "description": "Immutable audit log of MCR funnel stage transitions (IMPRESSION to MEANINGFUL_CONNECTION)"
    },
    "/connection_events/{eventId}": {
      "schema": "McrAuditEvent",
      "description": "Real-time connection funnel telemetry events mirroring MCR transitions"
    }
  }
}
