rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return isAuthenticated() && (request.auth.uid in data.participantUids);
    }

    // 1. Users & Accounts Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if true; // Public discovery view
      allow write: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/profiles/$(userId)));
    }

    // 3. User Preferences
    match /preferences/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/preferences/$(userId)));
    }

    // 4. Privacy Settings
    match /privacy/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/privacy/$(userId)));
    }

    // 5. Interaction Signals & Telemetry
    match /signals/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/signals/$(userId)));
    }

    // 6. Media Metadata Storage
    match /media_metadata/{mediaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Interactions (Likes / Passes)
    match /interactions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    // 8. Matches
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB);
    }

    // 9. Conversations and Messages
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantUids);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
      }
    }

    // 10. Safety: Blocks & Reports
    match /blocks/{blockId} {
      allow read, write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read, create: if isAuthenticated();
    }

    // 11. Discovery Events, Community Answers & Connection Graph Learnings
    match /discovery_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    match /connection_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    match /mcr_audit_events/{eventId} {
      allow read: if isAuthenticated();
      // Allow creation of auditable event records by authenticated users or backend
      allow create: if isAuthenticated();
      // Immutable audit log: disallow update and delete to preserve audit trail integrity
      allow update, delete: if false;
    }

    match /connection_learnings/{learningId} {
      allow read, write: if isAuthenticated();
    }

    match /community_answers/{answerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 12. Trust Graph & Secure Evidence Validation
    match /trust_signals/{userId} {
      allow read, write: if false; // Strictly private - backend & admin authority only
    }

    match /trust_evaluations/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId; // User can inspect own private status
      allow write: if false; // Prohibit client mutation
    }

    match /public_trust_badges/{userId} {
      allow read: if true; // Public minimal badges
      allow write: if false; // Server/Admin authority only - client cannot spoof
    }

    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Decisions are strictly backend/admin moderated
    }

    // 13. Admin & Moderation Access
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true; // Guarded by cryptographic PIN verification in applet logic
    }
  }
}
