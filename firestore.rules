rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return isAuthenticated() && (request.auth.uid in data.participantUids);
    }

    // 1. Users & Accounts Collection (4.21)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if true; // Public discovery view
      allow write: if isOwner(userId);
    }

    // 3. User Preferences
    match /preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 4. Privacy Settings
    match /privacy/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 5. Interaction Signals & Telemetry (Incremental)
    match /signals/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 6. Media Metadata Storage (4.22)
    match /media_metadata/{mediaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Interactions (Likes / Passes)
    match /interactions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    // 8. Matches
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB);
    }

    // 9. Conversations and Messages (Participant-scoped)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantUids);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
      }
    }

    // 10. Safety: Blocks & Reports
    match /blocks/{blockId} {
      allow read, write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read, create: if isAuthenticated();
    }

    // 11. Admin & Moderation Access
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true; // Guarded by cryptographic PIN verification in applet logic
    }
  }
}
